  </RecipeDef>

  <RecipeDef ParentName="HMM_MakeCandyBase">
    <defName>HMM_Make_MurderBuns</defName>
    <label>make murder buns</label>
    <description>Make murder buns out of sugar and flour.</description>
    <jobString>Making murder buns.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>VCE_Flour</li>
          </thingDefs>
        </filter>
        <count>40</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>VCE_RawSugar</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>VCE_RawSugar</li>
