  <RecipeDef ParentName="HMM_MakeCandyBase">
    <defName>HMM_Make_CandyCorn</defName>
    <label>make candy corn</label>
    <description>Make candy corn out of sugar and corn.</description>
    <jobString>Making candy corn.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RawCorn</li>
          </thingDefs>
        </filter>
        <count>40</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>VCE_RawSugar</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>VCE_RawSugar</li>
        <li>RawCorn</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <HMM_CandyCorn>10</HMM_CandyCorn>
    </products>
  </RecipeDef>

</Defs>
